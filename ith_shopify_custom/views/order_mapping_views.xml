<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="order_form_mapping_hold" model="ir.ui.view">
        <field name="name">ith.shopify.order.mapping.hold</field>
        <field name="model">shopify.order</field>
        <field name="inherit_id" ref="shopify_connector.shopify_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ith_retry_mapping" type="object"
                        string="Retry After SKU Mapping" invisible="not ith_mapping_pending"/>
            </xpath>
            <xpath expr="//field[@name='odoo_id']" position="after">
                <field name="ith_mapping_pending"/>
                <field name="error_message" readonly="1" invisible="not error_message"/>
            </xpath>
        </field>
    </record>
    <record id="order_list_mapping_hold" model="ir.ui.view">
        <field name="name">ith.shopify.order.list.mapping.hold</field>
        <field name="model">shopify.order</field>
        <field name="inherit_id" ref="shopify_connector.shopify_order_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="ith_mapping_pending" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_mapping_hold" model="ir.ui.view">
        <field name="name">ith.sale.order.mapping.hold</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="ith_shopify_mapping_pending" invisible="1"/>
                <widget name="web_ribbon" title="Requires SKU Mapping"
                        bg_color="text-bg-warning" invisible="not ith_shopify_mapping_pending"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="ith_shopify_source_sku" readonly="1" optional="show"/>
                <field name="ith_shopify_unmapped" readonly="1" optional="show"/>
                <field name="ith_shopify_mapping_issue" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="action_orders_mapping_hold" model="ir.actions.act_window">
        <field name="name">ITH — Orders Requiring SKU Mapping</field>
        <field name="res_model">shopify.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ith_mapping_pending', '=', True)]</field>
    </record>
</odoo>
