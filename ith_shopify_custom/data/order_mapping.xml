<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Not a catalogue item: no SKU, no stock, not selectable for sales.
             Original Shopify SKU/price/tax/quantity remain on each sale line. -->
        <record id="product_unmapped_order_line" model="product.product">
            <field name="name">ITH — Requires canonical SKU mapping</field>
            <field name="type">service</field>
            <field name="is_storable" eval="False"/>
            <field name="default_code" eval="False"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <record id="job_selected_orders_reconcile" model="queue.job.function">
        <field name="name">&lt;shopify.instance&gt;._ith_job_reconcile_selected_orders</field>
        <field name="channel_id" ref="shopify_connector.queue_channel_shopify_import"/>
    </record>
</odoo>
