<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="queue_channel_ith_joint_orders" model="queue.job.channel">
        <field name="name">ith_joint_orders</field>
        <field name="parent_id" ref="shopify_connector.queue_channel_shopify"/>
        <field name="removal_interval">30</field>
    </record>
    <record id="queue_channel_ith_joint_stock" model="queue.job.channel">
        <field name="name">ith_joint_stock</field>
        <field name="parent_id" ref="shopify_connector.queue_channel_shopify"/>
        <field name="removal_interval">30</field>
    </record>
    <record id="job_ith_joint_orders" model="queue.job.function">
        <field name="name">&lt;shopify.instance&gt;._ith_joint_refresh_orders</field>
        <field name="channel_id" ref="queue_channel_ith_joint_orders"/>
    </record>
    <record id="job_ith_joint_stock" model="queue.job.function">
        <field name="name">&lt;shopify.product.variant&gt;._ith_joint_push_inventory</field>
        <field name="channel_id" ref="queue_channel_ith_joint_stock"/>
    </record>
    <data noupdate="1">
        <record id="cron_ith_joint_policy" model="ir.cron">
            <field name="name">ITH — bounded joint orders and availability</field>
            <field name="model_id" ref="queue_job.model_queue_job"/>
            <field name="state">code</field>
            <field name="code">model._ith_joint_tick()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="queue_job_runner" eval="True"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
